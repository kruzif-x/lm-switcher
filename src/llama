#!/bin/bash
# =============================================================================
#  llama — CLI companion to the LM Switcher menu bar app
# =============================================================================
#
#  PURPOSE
#  -------
#  This is a bash-based command-line tool for managing local LLM model
#  servers. It complements the `LlamaMenubarApp` Swift menu bar app, sharing
#  the same on-disk state (PID files, logs) and the same `UserDefaults`
#  settings (via the `defaults` command on macOS).
#
#  The two tools can be used interchangeably: the menu bar app picks up
#  models launched by the CLI (via periodic `ps` scanning), and vice versa.
#
#  USAGE
#  -----
#      llama list                       # list all models (recursive scan)
#      llama load <model>               # start server (fuzzy match)
#      llama load <m1> <m2> ...         # start multiple
#      llama unload <model>             # stop one
#      llama unload all                 # stop all
#      llama switch <model> ...         # stop all, start new model(s)
#      llama status                     # show running + ports
#      llama ctx <model> <size>         # set per-model ctx
#      llama port <model> <port>        # set per-model port
#      llama menubar                    # launch menu bar app
#      llama uninstall                  # remove everything
#      llama help                       # show this help
#
#  STATE STORAGE
#  -------------
#  - PID files:     $LLAMA_DIR/pids/<safe-name>.pid
#                   First line is the PID. Second line is "PID --port N"
#                   for fast port recovery without re-scanning `ps`.
#  - Log files:     $LLAMA_DIR/logs/<safe-name>.log
#                   Captures stdout+stderr of each server process.
#  - Settings:      ~/Library/Preferences/local.llama-menubar.plist
#                   Read/written via the `defaults` command. The same
#                   domain is used by the Swift app, so settings stay
#                   in sync between the two tools.
#
#  MODEL TYPES
#  -----------
#  - GGUF: a single .gguf file. Served by `llama-server` (`-m <file>`).
#  - MLX:  a directory containing `*.safetensors` and `config.json`.
#         Served by `mlx_lm.server` (`--model <dir>`).
#
#  WHY BASH (NOT ZSH)
#  ------------------
#  Earlier versions of this script used zsh, but a zsh-specific parser
#  bug caused `local x; x=$(...)` patterns to corrupt the PATH inside
#  some functions, breaking commands like `cut`, `md5`, and `basename`.
#  Bash handles this pattern reliably, so we use bash explicitly.
# =============================================================================


# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------
# These are the runtime configuration values. Each can be overridden by
# setting the corresponding environment variable before invoking the script
# (e.g. `LLAMA_PORT=9000 llama load gemma`).

# Where PID files and log files live. Defaults to ~/.local/share/llama-menubar.
LLAMA_DIR="${LLAMA_DIR:-$HOME/.local/share/llama-menubar}"

# Absolute path to the llama-server binary (Homebrew location by default).
LLAMA_SERVER="${LLAMA_SERVER:-/opt/homebrew/bin/llama-server}"

# Absolute path to the mlx_lm.server entry script (pip --user install).
MLX_SERVER="${MLX_SERVER:-$HOME/Library/Python/3.14/bin/mlx_lm.server}"

# B1 fix: restrictive umask. PID files and server logs (which capture
# stdout/stderr — model paths, sometimes verbose content) must be
# owner-only. The default umask (022) leaves them world-readable (644),
# leaking the directory structure and server ports to other local users
# on shared Macs. 077 makes all subsequently-created files mode 600.
umask 077

# Ensure the base directory exists before doing anything else. Using
# `mkdir -p` is idempotent — safe to call even if the directory is present.
# B3 fix: guard the critical mkdir — a failed state dir must not cascade
# into confusing "file not found" errors downstream.
mkdir -p "$LLAMA_DIR" || { echo "Cannot create state dir $LLAMA_DIR" >&2; exit 1; }

# Subdirectories for per-process state. We keep one PID file and one log
# file per loaded model so multiple instances don't trample each other.
PIDS_DIR="$LLAMA_DIR/pids"
mkdir -p "$PIDS_DIR" || { echo "Cannot create pids dir $PIDS_DIR" >&2; exit 1; }
LOGS_DIR="$LLAMA_DIR/logs"
mkdir -p "$LOGS_DIR" || { echo "Cannot create logs dir $LOGS_DIR" >&2; exit 1; }

# User-overridable settings. Each is a `:- default` expression: if the
# variable is unset or empty, use the default.
# Models directory precedence: LLAMA_MODELS_DIR env, then the app's saved
# setting (same UserDefaults domain — keeps CLI and app scanning the SAME
# tree, as the settings-sync design intends), then ~/models.
MODELS_DIR="${LLAMA_MODELS_DIR:-$(defaults read local.llama-menubar modelsDir 2>/dev/null || echo "$HOME/models")}"
PORT="${LLAMA_PORT:-8080}"                       # default port
CTX_SIZE="${LLAMA_CTX_SIZE:-4096}"               # default ctx size (tokens)
CHAT_TEMPLATE="${LLAMA_CHAT_TEMPLATE:-}"          # optional chat template path
ENABLE_MTP="${LLAMA_ENABLE_MTP:-true}"             # enable MTP (on by default, auto-detected per model)


# -----------------------------------------------------------------------------
# Path helpers
# -----------------------------------------------------------------------------
# Callers pass the model's `id_hash` (first 12 hex chars of MD5 of the
# absolute path — see id_hash() below). It is already unique per absolute
# path and filesystem-safe (hex digits only), so we use it directly as the
# filename stem.
#
# B2 fix: the previous helpers derived the stem from the BASENAME only
# (`tr '/ ' '__'`). Two models with the same filename in different
# directories (e.g. ~/a/gemma.gguf and ~/b/gemma.gguf) produced the SAME
# stem, so the second load overwrote the first's PID file and the first
# process was orphaned (never killed by `unload`). Using the path-derived
# hash makes the stem unique per absolute path, matching the Swift app's
# `ModelEntry.id` semantics.
#
# The basename is kept in the filename for human readability of `logs/`
# and `status`, but the hash is what disambiguates.

# Print the PID file path for a given (id_hash, model_path).
pidfile_for() {
    local hash="$1" path="${2:-}"
    local b; b=$(basename "$path" 2>/dev/null)
    local s; s=$(echo "$b" | tr '/ ' '__')
    # Hash-first so the stem is unique even when basenames match.
    echo "$PIDS_DIR/${hash}.${s}.pid"
}

# Print the log file path for a given (id_hash, model_path).
logfile_for() {
    local hash="$1" path="${2:-}"
    local b; b=$(basename "$path" 2>/dev/null)
    local s; s=$(echo "$b" | tr '/ ' '__')
    echo "$LOGS_DIR/${hash}.${s}.log"
}

# B2 fix: refuse to write through a symlink. A pre-placed symlink at the
# PID/log path could redirect an `echo > $pf` (truncate) onto an
# attacker-chosen file. Returns 0 (safe) only if the path is absent or a
# regular file. Called before every write.
_not_symlink() {
    local target="$1"
    [[ -e "$target" ]] || return 0          # absent → safe to create
    [[ -L "$target" ]] && return 1          # symlink → refuse
    [[ -f "$target" ]] && return 0          # regular file → safe
    return 1                                # dir/device/etc → refuse
}


# -----------------------------------------------------------------------------
# Model discovery
# -----------------------------------------------------------------------------
# `list_all_models` performs a recursive scan of `$MODELS_DIR` and emits
# one line per discovered model on stdout. Each line has the format:
#
#     TYPE|PATH|NAME
#
#   TYPE: "gguf" or "mlx"
#   PATH: absolute path to the .gguf file or MLX directory
#   NAME: human-readable name (filename or directory name)
#
# This format is easy to parse downstream with `cut` or `IFS='|' read`.
#
# Hidden files are skipped. Specific .gguf prefixes are excluded (see the
# `case` in the loop below — must stay in sync with the Swift `ggufEntry`):
#   - mmproj-*.gguf           (vision projection, paired automatically)
#   - mtp-*.gguf              (multi-token-prediction head, loaded automatically)
#   - dflash-*.gguf           (DFlash block-diffusion drafter, loaded automatically)
#   - modernbert-embed-*.gguf (embedding model, not for chat)

list_all_models() {
    # If the models directory doesn't exist, return empty (not an error).
    [[ -d "$MODELS_DIR" ]] || return 0

    # GGUF: every .gguf file in the tree.
    while IFS= read -r f; do
        local bn; bn=$(basename "$f")
        case "$bn" in
            mmproj-*|mtp-*|dflash-*|modernbert-embed-*) continue ;;
        esac
        echo "gguf|$f|$bn"
    done < <(find "$MODELS_DIR" -type f -name "*.gguf" 2>/dev/null)

    # MLX: every directory that contains BOTH .safetensors and config.json.
    # We don't recurse into MLX dirs (each is a self-contained model), so
    # we just iterate all directories returned by `find -type d`.
    while IFS= read -r d; do
        if [[ -f "$d/config.json" ]] && ls "$d"/*.safetensors >/dev/null 2>&1; then
            echo "mlx|$d|$(basename "$d")"
        fi
    done < <(find "$MODELS_DIR" -type d 2>/dev/null)
}


# -----------------------------------------------------------------------------
# Query resolution
# -----------------------------------------------------------------------------
# `resolve_query <query>` accepts a user-provided substring (e.g. "gemma")
# and returns a single "TYPE|PATH" line that matches. If zero or multiple
# matches, it prints an error and returns non-zero. The matching is fuzzy:
# the query is a substring of the model name (filename or dir name).

resolve_query() {
    local query="$1"
    local line type path name matches_str count

    # Build a newline-separated list of matches. Using a string instead of
    # an array avoids zsh `local -a + +=` quirks we hit in earlier versions.
    matches_str=""
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        type=$(echo "$line" | cut -d'|' -f1)
        path=$(echo "$line" | cut -d'|' -f2)
        name=$(echo "$line" | cut -d'|' -f3)
        # Match against the model name (not the path), so users can
        # type "gemma" instead of the full filename.
        if [[ "$name" == *"$query"* ]] || [[ "$(basename "$path")" == *"$query"* ]]; then
            if [[ -z "$matches_str" ]]; then
                matches_str="$line"
            else
                matches_str="${matches_str}
$line"
            fi
        fi
    done < <(list_all_models)

    # No matches: distinguish "no models at all" from "no match".
    if [[ -z "$matches_str" ]]; then
        count=$(list_all_models | wc -l | tr -d ' ')
        if [[ "$count" -eq 0 ]]; then
            echo "No models found in $MODELS_DIR" >&2
        else
            echo "No model matching '$query'" >&2
        fi
        return 1
    fi

    # Multiple matches: show them all and refuse to guess.
    local match_count
    match_count=$(echo "$matches_str" | wc -l | tr -d ' ')
    if [[ "$match_count" -gt 1 ]]; then
        echo "Multiple models match '$query':" >&2
        local m
        while IFS= read -r m; do
            echo "  [$(echo "$m" | cut -d'|' -f1)] $(echo "$m" | cut -d'|' -f3)" >&2
        done <<< "$matches_str"
        return 1
    fi

    # Single match: emit it.
    echo "$matches_str"
}


# -----------------------------------------------------------------------------
# State queries
# -----------------------------------------------------------------------------
# These read the on-disk PID files (and the Swift app's UserDefaults) to
# answer simple questions like "is this model loaded?" and "what port
# is it on?".

# Is a model with the given (id_hash, path) currently running? We treat
# the model as running iff its PID file exists AND the process it points
# to is alive.
is_loaded() {
    local id="$1" path="${2:-}"
    local pidfile; pidfile=$(pidfile_for "$id" "$path")
    [[ -f "$pidfile" ]] || return 1
    local pid; pid=$(head -1 "$pidfile" 2>/dev/null | tr -d '[:space:]')
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

# What port is the model with the given (id_hash, path) listening on?
# Reads the second line of the PID file (which we wrote as
# "PID --port N" for fast recovery). Falls back to scanning `ps`.
get_port_for() {
    local id="$1" path="${2:-}"
    local pidfile; pidfile=$(pidfile_for "$id" "$path")
    [[ -f "$pidfile" ]] || return 1
    local pid; pid=$(head -1 "$pidfile" 2>/dev/null | tr -d '[:space:]')
    # Prefer the embedded port info we wrote.
    local pp
    pp=$(grep -oE '\--port [0-9]+' "$pidfile" 2>/dev/null | awk '{print $2}')
    [[ -n "$pp" ]] && { echo "$pp"; return; }
    # Fall back: ask the live process.
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    ps -o args= -p "$pid" 2>/dev/null | grep -oE '\--port [0-9]+' | awk '{print $2}'
}

# Read the per-model preferred port from defaults(1). Returns 0 if unset.
per_model_port() {
    local id_hash="$1"
    local key="model.${id_hash}.port"
    defaults read local.llama-menubar "$key" 2>/dev/null || echo 0
}

# Read the per-model context size from defaults(1). Falls back to the
# default ctx size if the per-model value is unset or zero.
per_model_ctx() {
    local id_hash="$1"
    local key="model.${id_hash}.ctx"
    local stored; stored=$(defaults read local.llama-menubar "$key" 2>/dev/null || echo 0)
    if [[ "$stored" -gt 0 ]]; then
        echo "$stored"
    else
        echo "$CTX_SIZE"
    fi
}

# Compute a short, stable hash of a model path. We use this as the key
# for per-model settings and PID files. md5 is used because it's a
# stable, widely-available hash.
id_hash() {
    # IMPORTANT: hash the path bytes with NO trailing newline so this
    # matches the Swift app's `Insecure.MD5.hash(data: Data(model.id.utf8))`.
    # A here-string (`<<<`) appends a newline and would produce a DIFFERENT
    # digest, breaking cross-tool per-model settings (model.<hash>.port/ctx).
    # `md5 -s` hashes the literal string argument with no added newline.
    local h; h=$(md5 -q -s "$1")
    echo "${h:0:12}"
}

# Read a global setting from the shared UserDefaults domain (the same domain
# the Swift app writes), falling back to a default when unset. This keeps the
# CLI and the menu bar app applying the SAME llama-server flags, instead of the
# CLI hardcoding a small subset and silently diverging from the app.
#   pref <key> <default>
pref() {
    defaults read local.llama-menubar "$1" 2>/dev/null || echo "$2"
}

# Bool variant: defaults stores booleans as 1/0. Normalize to true/false.
#   pref_bool <key> <default(true|false)>
pref_bool() {
    local v; v=$(defaults read local.llama-menubar "$1" 2>/dev/null || echo "$2")
    case "$v" in
        1|true|YES|yes) echo true ;;
        *)              echo false ;;
    esac
}

# Per-model variant of pref(): prefer model.<id_hash>.<key> (the app's
# per-model overrides), falling back to the global key. Mirrors the Swift
# app's pm()/perModelSetting. Requires $id_hash in scope (set by load_model).
#   pm <key> <default>
pm() {
    local key="$1" def="$2"
    local mv; mv=$(defaults read local.llama-menubar "model.${id_hash}.${key}" 2>/dev/null)
    if [[ -n "$mv" ]]; then echo "$mv"; else pref "$key" "$def"; fi
}

# Bool variant of pm().
pm_bool() {
    local key="$1" def="$2"
    local mv; mv=$(defaults read local.llama-menubar "model.${id_hash}.${key}" 2>/dev/null)
    if [[ -n "$mv" ]]; then
        case "$mv" in
            1|true|YES|yes) echo true ;;
            *)              echo false ;;
        esac
    else
        pref_bool "$key" "$def"
    fi
}


# -----------------------------------------------------------------------------
# Port allocation
# -----------------------------------------------------------------------------
# Find the smallest unused port starting at $PORT. We need this so that
# loading multiple models doesn't collide on the same port.

next_port() {
    local used_str="" p pf port
    # `nullglob` makes a glob that matches nothing expand to nothing
    # (instead of the literal pattern). Without it, an empty pids
    # directory would cause "no matches found" errors under bash.
    shopt -s nullglob
    for pf in "$PIDS_DIR"/*.pid; do
        [[ -f "$pf" ]] || continue
        p=$(head -1 "$pf" 2>/dev/null)
        # Skip dead PIDs (the file is stale).
        [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null || continue
        # Read --port N from the live process. Most reliable source.
        local pp
        pp=$(ps -o args= -p "$p" 2>/dev/null | grep -oE '\--port [0-9]+' | awk '{print $2}')
        [[ -n "$pp" ]] && used_str="${used_str} ${pp}"
    done
    shopt -u nullglob

    # Walk up from $PORT until we find one not in `used_str`.
    port=$PORT
    while [[ " ${used_str} " == *" ${port} "* ]]; do
        ((port++))
    done
    echo $port
}


# -----------------------------------------------------------------------------
# Load / Unload
# -----------------------------------------------------------------------------
# `load_model` starts a server process for one model. `unload_model` stops
# it. `cmd_unload all` iterates all PID files and unloads each.

# Start a server process for a "TYPE|PATH|NAME" line.
load_model() {
    local line="$1"
    # Parse the three fields.
    local type; type=$(echo "$line" | cut -d'|' -f1)
    local path; path=$(echo "$line" | cut -d'|' -f2)
    local name; name=$(echo "$line" | cut -d'|' -f3)
    local id_hash; id_hash=$(id_hash "$path")

    # If the same model is already running on some port, no-op.
    if is_loaded "$id_hash" "$path"; then
        echo "● [$type] $name already loaded on port $(get_port_for "$id_hash" "$path")"
        return 0
    fi

    # Pick a port: an explicit `load --port N` flag wins (ephemeral, never
    # persisted — used by the MCP for per-call overrides); then the
    # per-model saved port; otherwise the next free port from $PORT.
    local preferred; preferred=$(per_model_port "$id_hash")
    local port
    if [[ -n "$FORCE_PORT" && "$FORCE_PORT" -gt 0 ]]; then
        port=$FORCE_PORT
    elif [[ "$preferred" -gt 0 ]]; then
        port=$preferred
    else
        port=$(next_port)
    fi
    # Ctx: same precedence — `load --ctx N` flag, then per-model, then default.
    local ctx
    if [[ -n "$FORCE_CTX" && "$FORCE_CTX" -gt 0 ]]; then
        ctx=$FORCE_CTX
    else
        ctx=$(per_model_ctx "$id_hash")
    fi

    # Build the command line, depending on the backend.
    local -a args=()
    local executable
    if [[ "$type" == "gguf" ]]; then
        executable="$LLAMA_SERVER"
        args=("-m" "$path")
        # Auto-pair mmproj: try name-based match first, then fallback to
        # any mmproj-*.gguf in the directory (handles QAT/generic naming).
        local dir; dir=$(dirname "$path")
        local base; base=$(basename "$path" .gguf)
        # Strip ALL quant suffixes to mirror the Swift `findCompanion` regex
        # exactly (K-quants, I-quants like -IQ4_NL, and float types
        # -F16/-F32/-BF16) so name-based mmproj pairing behaves identically in
        # both tools. Previously the CLI only stripped -Q* and diverged on
        # IQ/BF16-named models.
        local stripped; stripped=$(echo "$base" | sed -E 's/-(Q[0-9]+(_[0-9]+)?(_K)?(_[A-Z]+)?|IQ[0-9]+(_[A-Z]+)+|F16|F32|BF16)$//')
        # DFlash drafter: detect EARLY so the sampling gate below sees
        # ddraft_attached before it decides on top-p/top-k.
        local ddraft=""
        if [[ "$(pm_bool enableDflash true)" == "true" ]]; then
            for f in "$dir/dflash-"*.gguf; do
                [[ -f "$f" ]] && ddraft="$f" && break
            done
            [[ -n "$ddraft" ]] && ddraft_attached=1
        fi
        shopt -s nullglob
        local f

        # Auto-pair mmproj: try name-based match first, then fallback to
        # any mmproj-*.gguf in the directory (handles QAT/generic naming).
        local mmproj_found=0
        for f in "$dir/mmproj-${stripped}-"*.gguf; do
            [[ -f "$f" ]] && args+=("--mmproj" "$f") && mmproj_found=1 && break
        done
        if [[ $mmproj_found -eq 0 ]]; then
            for f in "$dir/mmproj-"*.gguf; do
                [[ -f "$f" ]] && args+=("--mmproj" "$f") && break
            done
        fi

        # MTP heads: some models ship MTP built into the GGUF (infix -mtp-),
        # while others carry a separate mtp-*.gguf companion. If a companion
        # exists, pass --spec-draft-model explicitly. Also check MTP/ subdir
        # (HuggingFace convention).
        # Apply chat template override if configured via env var.
        # Agentic harnesses (opencode, pi) need custom templates to fix
        # tool-calling edge cases (broken arg formatting, dropped reasoning,
        # disabled thinking, null corruption).
        # Apply chat template override if configured via env var.
        if [[ -n "$CHAT_TEMPLATE" && -f "$CHAT_TEMPLATE" ]]; then
            args+=("--chat-template" "$CHAT_TEMPLATE")
            echo "  ✓ Using chat template: $CHAT_TEMPLATE"
        fi
        shopt -u nullglob
        # Bind to localhost, set the ctx size, then any global extras.
        args+=("--host" "127.0.0.1" "--port" "$port")
        # All GPU layers on Metal — unified memory, no VRAM split.
        args+=("-ngl" "99")
        args+=("--ctx-size" "$ctx")

        # --- Parity with the menu bar app (read shared UserDefaults) ---------
        # The app and CLI share the `local.llama-menubar` domain, so a model
        # loaded from the terminal now gets the same KV-cache, flash-attention,
        # sampling, thinking, and performance flags the app would apply.

        # KV cache quantization (app defaults: q8_0 K / q4_0 V).
        local _kvk _kvv
        _kvk=$(pm kvCacheTypeK q8_0)
        _kvv=$(pm kvCacheTypeV q4_0)
        args+=("--cache-type-k" "$_kvk" "--cache-type-v" "$_kvv")

        # Flash attention (app default: on).
        [[ "$(pref_bool flashAttention true)" == "true" ]] && args+=("-fa" "on")

        # Slots endpoint (local-only) — lets the app's TTL auto-unload
        # poll detect activity on CLI-launched servers too.
        args+=("--slots")

        # Reasoning suppression — Gemma 4 emits a `reasoning_content` field
        # that breaks OpenAI-compatible clients (opencode, pi, OpenClaw).
        # Gated behind the same `suppressReasoning` setting the app uses
        # (default on) instead of being applied unconditionally to every model.
        # See docs/GEMMA4_LOADING_DETAILS.md §3.2.
        [[ "$(pm_bool suppressReasoning true)" == "true" ]] && \
            args+=("--reasoning" "off" "--reasoning-format" "none")

        # Thinking mode (app default: on). When off, disable via chat-template
        # kwargs, matching the app.
        if [[ "$(pm_bool thinkingEnabled true)" != "true" ]]; then
            args+=("--chat-template-kwargs" '{"enable_thinking":false}')
        fi

        # Sampling defaults (shared with MLX in the app).
        args+=("--temp" "$(pm temperature 0.8)")
        # top-p/top-k/repeat-penalty skew the distribution the DFlash
        # drafter verifies against, collapsing block acceptance (measured
        # on Muse Glimmer: 63% -> 13%, 25 t/s -> 7 t/s). Omit while a
        # DFlash drafter is attached; temperature stays user-controlled.
        if [[ "${ddraft_attached:-0}" != "1" ]]; then
            args+=("--top-p"          "$(pm topP 0.95)")
            args+=("--top-k"          "$(pm topK 20)")
            args+=("--repeat-penalty" "$(pm repeatPenalty 1.0)")
        fi
        local _seed; _seed=$(pref seed 0)
        [[ "$_seed" -gt 0 ]] 2>/dev/null && args+=("--seed" "$_seed")

        # Performance (llama-server only).
        local _threads; _threads=$(pref cpuThreads 0)
        [[ "$_threads" -gt 0 ]] 2>/dev/null && args+=("-t" "$_threads")
        args+=("-b" "$(pref batchSize 2048)")
        [[ "$(pref_bool mlock false)"  == "true" ]] && args+=("--mlock")
        [[ "$(pref_bool noMmap false)" == "true" ]] && args+=("--no-mmap")

        # MTP: ON by default. Checks if model has companion mtp-*.gguf or
        # built-in MTP (filename infix -MTP-). Silently skipped if not.
        local mtp_check; mtp_check=false
        if [[ "$ENABLE_MTP" == "true" || "$ENABLE_MTP" == "1" \
              || "$(pm_bool enableMtp true)" == "true" ]]; then
            mtp_check=true
        fi
        if [[ "$mtp_check" == "true" ]]; then
            # Check for companion mtp-*.gguf
            local dir; dir="$(dirname "$path")"
            local bn; bn="$(basename "$path")"
            local draft_file=""
            for f in "$dir/mtp-"*.gguf; do
                [[ -f "$f" ]] && draft_file="$f" && break
            done
            if [[ -z "$draft_file" && -d "$dir/MTP" ]]; then
                for f in "$dir/MTP/"*.gguf; do
                    [[ -f "$f" ]] && draft_file="$f" && break
                done
            fi
            # Check for built-in MTP (filename infix -MTP- or -mtp-)
            local has_infix=false
            if [[ "$bn" =~ [-_]MTP[-_] || "$bn" =~ [-_]mtp[-_] ]]; then
                has_infix=true
            fi
            if [[ -n "$draft_file" || "$has_infix" == "true" ]]; then
                args+=("--spec-type" "draft-mtp")
                if [[ -n "$draft_file" ]]; then
                    args+=("--spec-draft-model" "$draft_file")
                fi
            fi
        fi

        # DFlash (block-diffusion speculative decoding): ON by default.
        # Muse Glimmer ships dflash-kquant.gguf as a companion drafter.
        # Skipped when no dflash-*.gguf companion exists, or when MTP was
        # already attached (the two speculative methods are exclusive).
        if [[ "$(pm_bool enableDflash true)" == "true" ]]; then
            local has_spec=false
            local a
            for a in "${args[@]}"; do
                [[ "$a" == "--spec-type" ]] && has_spec=true
            done
            if [[ "$has_spec" == "false" ]]; then
                if [[ -n "$ddraft" ]]; then
                    ddraft_attached=1
                    args+=("--spec-type" "draft-dflash")
                    args+=("--spec-draft-model" "$ddraft")
                    args+=("--spec-draft-n-max" "15")
                    # Adaptive disengage: acceptance below 0.4 (Muse's
                    # reasoning phase on open-ended prompts) stops the
                    # drafter — measured net loss without it (7.5 t/s vs
                    # 10 t/s baseline). Structured prompts keep full speed.
                    args+=("--spec-draft-p-min" "0.4")
                fi
            fi
        fi
    else
        # MLX: invoke mlx_lm.server. No mmproj, no explicit ctx (mlx
        # uses the model's own config).
        executable="$MLX_SERVER"
        args=("--model" "$path" "--host" "127.0.0.1" "--port" "$port")
    fi

    # Append any user-provided extra args (split on whitespace).
    # C-2 fix: use `read -ra` instead of unquoted `$LLAMA_EXTRA_ARGS`.
    # Unquoted expansion also performs pathname/glob expansion and is
    # word-split unpredictably; `read -ra` splits on IFS only (no globbing),
    # producing a clean argv array.
    if [[ -n "$LLAMA_EXTRA_ARGS" ]]; then
        read -ra _extra_args <<< "$LLAMA_EXTRA_ARGS"
        args+=("${_extra_args[@]}")
    fi

    echo "Loading [$type] $name on :$port ..."

    # Resolve PID/log paths up front (hash-first stem → unique per path).
    local pf; pf=$(pidfile_for "$id_hash" "$path")
    local lf; lf=$(logfile_for "$id_hash" "$path")

    # B2 fix: refuse to write through a symlink — a pre-placed symlink
    # could redirect the truncating `>` onto an attacker-chosen file.
    _not_symlink "$pf" || { echo "✗ Refusing to write PID file (symlink?): $pf" >&2; return 1; }
    _not_symlink "$lf" || { echo "✗ Refusing to write log file (symlink?): $lf" >&2; return 1; }

    # nohup detaches the child from the controlling terminal so it
    # survives the parent shell exiting. We redirect all output to a
    # per-model log file so the user can `tail -f` it.
    nohup "$executable" "${args[@]}" > "$lf" 2>&1 &

    # Capture the new PID and write the PID file.
    local newpid; newpid=$!
    echo "$newpid" > "$pf"
    # Second line is the port — for fast get_port_for() without ps.
    echo "$newpid --port $port" >> "$pf"

    # M-11 fix: replace the fixed 1s `kill -0` heuristic with a readiness
    # poll. A large GGUF can take several seconds to mmap; a fast-failing
    # binary can die after 1s. Poll the port for up to ~15s: success when
    # the port is listening, failure if the process dies first or we time
    # out. `nc -z` is the primary probe; `lsof` is the fallback if nc is
    # unavailable.
    local _deadline=$(( $(date +%s) + 15 ))
    local _ready=0
    while (( $(date +%s) < _deadline )); do
        # Process died → stop waiting (load failed).
        if ! kill -0 "$newpid" 2>/dev/null; then
            break
        fi
        # Port listening yet?
        if command -v nc >/dev/null 2>&1; then
            if nc -z 127.0.0.1 "$port" 2>/dev/null; then _ready=1; break; fi
        elif command -v lsof >/dev/null 2>&1; then
            if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then _ready=1; break; fi
        else
            # No probe tool — fall back to the old liveness check.
            sleep 1
            if kill -0 "$newpid" 2>/dev/null; then _ready=1; fi
            break
        fi
        sleep 0.3
    done

    if (( _ready == 1 )); then
        echo "● [$type] $name loaded on :$port (PID $newpid)"
    else
        echo "✗ Failed to start $name (not listening on :$port)"
        kill -TERM "$newpid" 2>/dev/null
        rm -f "$pf"
        return 1
    fi
}

# Stop a single model. Takes the PID file path and a display name (the
# name is only used for user-facing messages). Passing the pidfile path
# directly avoids re-deriving it and works uniformly for named and "all"
# unloads.
unload_model() {
    local pidfile="$1"
    local name="$2"
    if [[ ! -f "$pidfile" ]]; then
        echo "○ $name not loaded"
        return 0
    fi
    local pid; pid=$(head -1 "$pidfile" 2>/dev/null | tr -d '[:space:]')
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        echo "Stopping $name (PID $pid) ..."
        # SIGTERM (default for `kill`) gives the process a chance to
        # shut down gracefully. We escalate to SIGKILL if it's still
        # alive after a second.
        kill "$pid" 2>/dev/null
        sleep 1
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
        echo "✓ $name stopped"
    else
        echo "○ $name already stopped"
    fi
    # Always remove the PID file, even if the process was already dead.
    rm -f "$pidfile"
}


# -----------------------------------------------------------------------------
# Subcommands
# -----------------------------------------------------------------------------
# Each `cmd_*` function implements one user-facing subcommand. The `case`
# at the bottom dispatches to them.

# Show the current state: one line per running model.
cmd_status() {
    local any=0
    shopt -s nullglob
    for pf in "$PIDS_DIR"/*.pid; do
        [[ -f "$pf" ]] || continue
        # Filename stem is now "<hash>.<basename>.pid"; the hash is the
        # part before the first dot.
        local id_hash; id_hash=$(basename "$pf" .pid); id_hash="${id_hash%%.*}"
        local pid; pid=$(head -1 "$pf" 2>/dev/null | tr -d '[:space:]')
        if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
            local argline; argline=$(ps -o args= -p "$pid" 2>/dev/null)
            local port
            port=$(echo "$argline" | grep -oE '\--port [0-9]+' | awk '{print $2}')
            # Extract the model file/dir name. `-m` can point at paths with
            # spaces, and the argline also contains MORE .gguf paths
            # (--spec-draft-model dflash-kquant.gguf, --mmproj ...), so the
            # old greedy regex `(.+\.gguf)` matched the LAST .gguf (the
            # drafter). Instead: cut everything before " -m ", then cut at
            # the FIRST ".gguf" (lazy semantics, space-safe).
            local mpath="" mname
            if [[ "$argline" == *" -m "* ]]; then
                local rest="${argline#*-m }"
                mpath="${rest%%.gguf*}.gguf"
            elif [[ "$argline" =~ \ --model\ (.+)\ --host ]]; then
                mpath="${BASH_REMATCH[1]}"
            fi
            [[ -n "$mpath" ]] && mname=$(basename "$mpath") || mname="$id_hash"
            echo "● $mname  :$port  (PID $pid)"
            any=1
        else
            # Stale PID file — process is gone, clean up.
            rm -f "$pf"
        fi
    done
    shopt -u nullglob
    [[ $any -eq 0 ]] && echo "○ No models loaded"
}

# List all discovered models with a "●" marker next to running ones.
cmd_list() {
    local all_str
    all_str=$(list_all_models)
    if [[ -z "$all_str" ]]; then
        echo "No models in $MODELS_DIR"
        return 1
    fi
    # Use `read -r` with a custom IFS to split on "|" cleanly. This
    # avoids subshells from `cut` and works in bash without the zsh
    # `local -a + +=` quirks we hit earlier.
    local l
    while IFS='|' read -r type path name; do
        [[ -z "$type" ]] && continue
        local id_hash; id_hash=$(id_hash "$path")
        local marker=" "
        is_loaded "$id_hash" && marker="●"
        echo " $marker [$type] $name"
    done <<< "$all_str"
}

# `llama load <m1> [m2 ...]` — load one or more models.
cmd_load() {
    # Ephemeral per-invocation overrides (MCP_SPEC §3.3): `--ctx N` and
    # `--port N` beat per-model saved settings for THIS launch only and
    # are never persisted. Globals consumed by load_model.
    FORCE_CTX=""
    FORCE_PORT=""
    while [[ "${1:-}" == --* ]]; do
        case "$1" in
            --ctx)  FORCE_CTX="$2";  shift 2 ;;
            --port) FORCE_PORT="$2"; shift 2 ;;
            *) echo "Unknown flag: $1 (supported: --ctx N, --port N)"; return 1 ;;
        esac
    done
    if [[ $# -eq 0 ]]; then
        echo "Usage: llama load [--ctx N] [--port N] <model> [model2 ...]"
        return 1
    fi
    for q in "$@"; do
        local line; line=$(resolve_query "$q") || return 1
        load_model "$line"
    done
}

# `llama unload <m>` or `llama unload all`.
cmd_unload() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: llama unload <model>|all"
        return 1
    fi
    for q in "$@"; do
        if [[ "$q" == "all" ]]; then
            shopt -s nullglob
            for pf in "$PIDS_DIR"/*.pid; do
                [[ -f "$pf" ]] || continue
                local id_hash; id_hash=$(basename "$pf" .pid); id_hash="${id_hash%%.*}"
                local pid; pid=$(head -1 "$pf" 2>/dev/null | tr -d '[:space:]')
                # L-12 fix: the old sed `s/.*\(...\).*//` deleted everything,
                # leaving mname empty so the user saw "○  stopped" with no
                # name. Extract the model file/dir name from the process args
                # for a useful display label (same approach as `cmd_status`).
                local mname
                mname=$(ps -o args= -p "$pid" 2>/dev/null \
                    | grep -oE '(\-m|--model) [^ ]+' | head -1 \
                    | awk '{print $2}' | xargs -I{} basename {} 2>/dev/null)
                [[ -z "$mname" ]] && mname="$id_hash"
                unload_model "$pf" "$mname"
            done
            shopt -u nullglob
        else
            local line; line=$(resolve_query "$q") || return 1
            local path; path=$(echo "$line" | cut -d'|' -f2)
            local name; name=$(echo "$line" | cut -d'|' -f3)
            local id_hash; id_hash=$(id_hash "$path")
            local pf; pf=$(pidfile_for "$id_hash" "$path")
            unload_model "$pf" "$name"
        fi
    done
}

# `llama switch <m1> [m2 ...]` — atomic double-buffer switch (no gap).
# Loads the new model first, verifies it started, THEN unloads old models.
# If the new model fails to load, old models keep running (rollback).
cmd_switch() {
    local _target="$1"
    [[ -z "$_target" ]] && { echo "Usage: llama switch <model>"; return 1; }

    # Snapshot the currently-running PIDs before we do anything.
    local _old_pids=()
    local _pf
    shopt -s nullglob
    for _pf in "$PIDS_DIR"/*.pid; do
        [[ -f "$_pf" ]] || continue
        local _pid; _pid=$(head -1 "$_pf" 2>/dev/null)
        [[ -n "$_pid" ]] && _old_pids+=("$_pf:$_pid")
    done
    shopt -u nullglob

    # Load the target on a NEW port (existing processes unaffected).
    cmd_load "$_target" || {
        echo "✗ Switch failed: target failed to load (old models untouched)"
        return 1
    }

    # Now safe to unload the old models.
    for _entry in "${_old_pids[@]}"; do
        local _pf="${_entry%%:*}"
        local _pid="${_entry#*:}"
        kill -TERM "$_pid" 2>/dev/null
        rm -f "$_pf"
    done

    echo "✓ Switched to $_target"
}

# `llama ctx <model> <size>` — set per-model context size (applies next load).
cmd_ctx() {
    if [[ $# -lt 2 ]]; then
        echo "Usage: llama ctx <model> <size>"
        return 1
    fi
    local q="$1"
    local size="$2"
    local line; line=$(resolve_query "$q") || return 1
    local path; path=$(echo "$line" | cut -d'|' -f2)
    local id_hash; id_hash=$(id_hash "$path")
    defaults write local.llama-menubar "model.${id_hash}.ctx" -int "$size"
    echo "✓ $(echo "$line" | cut -d'|' -f3) context size set to $size (applies on next load)"
}

# `llama port <model> <port>` — set per-model preferred port (0 = auto).
cmd_port() {
    if [[ $# -lt 2 ]]; then
        echo "Usage: llama port <model> <port>"
        return 1
    fi
    local q="$1"
    local port="$2"
    local line; line=$(resolve_query "$q") || return 1
    local path; path=$(echo "$line" | cut -d'|' -f2)
    local id_hash; id_hash=$(id_hash "$path")
    defaults write local.llama-menubar "model.${id_hash}.port" -int "$port"
    echo "✓ $(echo "$line" | cut -d'|' -f3) preferred port set to $port (applies on next load)"
}

# `llama menubar` — launch the menu bar app from its standard install location.
cmd_menubar() {
    local app="$HOME/Applications/LM Switcher.app"
    if [[ -d "$app" ]]; then
        open "$app"
    else
        # Fall back to the legacy location, in case the user hasn't
        # re-run install.sh since the move to ~/Applications/.
        app="$HOME/bin/lm-switcher.app"
        if [[ -d "$app" ]]; then
            open "$app"
        else
            echo "lm-switcher not found. Run install.sh first."
            return 1
        fi
    fi
}

# `llama uninstall` — exec the uninstaller script, replacing this shell.
cmd_uninstall() {
    local script="$HOME/bin/uninstall.sh"
    if [[ -f "$script" ]]; then
        echo "Running uninstaller..."
        exec "$script"
    else
        echo "uninstall.sh not found at $script"
        return 1
    fi
}


# -----------------------------------------------------------------------------
# Command dispatch
# -----------------------------------------------------------------------------
# The first positional argument (`$1`) selects the subcommand. We use a
# `case` statement rather than a lookup table for clarity and so the
# help text can include a long multi-line usage block.

case "${1:-help}" in
    status)         cmd_status ;;
    list|ls)        cmd_list ;;
    load)           shift; cmd_load "$@" ;;
    unload|stop)    shift; cmd_unload "$@" ;;
    switch|swap)    shift; cmd_switch "$@" ;;
    ctx)            shift; cmd_ctx "$@" ;;
    port)           shift; cmd_port "$@" ;;
    menubar)        cmd_menubar ;;
    uninstall)      cmd_uninstall ;;
    help|--help|-h)
        # Heredoc with 'EOF' (quoted) prevents variable expansion in the
        # help text, so $VAR sequences display literally.
        cat <<'EOF'
Usage: llama <command> [args]

Commands:
  list                       List all models (recursive scan of LLAMA_MODELS_DIR)
  load <m1> [m2 ...]         Load 1+ models (GGUF or MLX, each on own port)
  unload <m>|all             Unload a specific model or all
  switch <m1> [m2 ...]       Unload all, then load new model(s)
  status                     Show all running models + ports
  ctx <model> <size>         Set per-model context size
  port <model> <port>        Set per-model port (0 = auto)
  menubar                    Launch menu bar app
  uninstall                  Remove LLM switcher completely

Config (env vars):
  LLAMA_MODELS_DIR  Models directory (default: ~/models) - RECURSIVE scan
  LLAMA_PORT        Default port (default: 8080)
  LLAMA_CTX_SIZE    Default context size (default: 4096)
  LLAMA_EXTRA_ARGS  Extra args for llama-server
  LLAMA_SERVER      Path to llama-server (default: /opt/homebrew/bin/llama-server)
  MLX_SERVER        Path to mlx_lm.server (default: ~/Library/Python/3.14/bin/mlx_lm.server)

Examples:
  llama load gemma                       # load GGUF model
  llama load gemma llama                 # load 2 models
  llama unload gemma                     # unload just gemma
  llama unload all                       # unload everything
  LLAMA_MODELS_DIR=~/models llama list   # scan different dir
EOF
        ;;
    *)
        echo "Unknown command: $1"
        echo "Try 'llama help' for usage."
        exit 1
        ;;
esac
